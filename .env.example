# Server-side variables only. Copy to .env.local and supply your project values.
# Use demo for a read-only preview without accounts or database access.
# Set live only after the reviewed migrations have been approved and applied.
APP_MODE=demo
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GOOGLE_AUTH_ENABLED=false

# Keep AI disabled until its authenticated routes and usage limits are ready.
AI_ENABLED=false
AI_MULTI_CUTOUT_ENABLED=false
AI_DAILY_LIMIT=60
AI_USER_DAILY_LIMIT=15
AI_OWNER_DAILY_LIMIT=30

# App provider keys are separate from credentials used by coding agents.
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026
META_API_KEY=
META_MODEL=muse-spark-1.3
AI_DRAFT_PROVIDER=meta

# Hard-budget metering (mandatory): server-only service_role, never NEXT_PUBLIC.
# Missing credential or empty pricebook fails closed; no legacy bypass.
SUPABASE_SERVICE_ROLE_KEY=

# Owner-only test gate — keep blank by default, never commit real email
AI_TEST_MODE=
AI_OWNER_ALLOWLIST=
AI_MAX_RETRIES=0
