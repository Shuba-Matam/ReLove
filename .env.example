# Server-side variables only. Copy to .env.local and supply your project values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional local setup credentials; configured directly in hosted Supabase Auth.
# The Next.js application does not need these values to initiate Supabase OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Keep AI disabled until its authenticated routes and usage limits are ready.
AI_ENABLED=false
